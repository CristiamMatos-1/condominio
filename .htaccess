# ============================================================
# .htaccess RAIZ — AGNOSTICO A SUBPASTA (funciona em / OU /condominio)
#
# Objetivo:
#   - NUNCA mais quebrar por causa de subpasta
#   - NUNCA dar erro 403 por diretiva proibida
#   - Usar REQUEST_URI procurando '/public/' em QUALQUER posicao
# ============================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ============================================================
    # BLOQUEIO DE PASTAS (sempre retorna 403 via [F])
    # ============================================================
    RewriteRule (^|/)app(/|$) - [F,L,NC]
    RewriteRule (^|/)database(/|$) - [F,L,NC]
    RewriteRule (^|/)vendor(/|$) - [F,L,NC]
    RewriteRule (^|/)\.github(/|$) - [F,L,NC]
    RewriteRule (^|/)node_modules(/|$) - [F,L,NC]
    RewriteRule (^|/)tests(/|$) - [F,L,NC]

    # ============================================================
    # BLOQUEIO DE ARQUIVOS SENSIVEIS
    # Nota: install.php / instalador_unico.php / info_condominio.php
    #       NAO sao bloqueados aqui. O usuario usa-os no deploy e
    #       DEVE apaga-los manualmente apos o uso (conforme tela).
    # ============================================================
    RewriteCond %{REQUEST_FILENAME} (/|^)deploy_ftp\.php$ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} (/|^)config(\.example)?\.php$ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} (/|^)\.env(\..*)?$ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} (/|^)error_php\.log$ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} (/|^)(composer|package)(-lock)?\.(json|lock)$ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} (/|^)README(\.md)?$ [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # ROTEAMENTO PARA O PONTO DE ENTRADA public/index.php
    #
    # Exemplos que funcionam com essas regras (sem RewriteBase!) :
    #   /public_html/index.php           → /public/index.php
    #   /public_html/condominio/         → /condominio/public/index.php
    #   /public_html/qualquer/nome/      → /qualquer/nome/public/index.php
    # ============================================================
    # Se a URL JA contem /public/ em qualquer lugar...
    RewriteCond %{REQUEST_URI} /public/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*?/)?public/(.*)$ $1public/index.php?route=$2 [QSA,L]

    # Se a URL NAO contem /public/ → re-escreve para a pasta public
    RewriteCond %{REQUEST_URI} !/public/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
</IfModule>

# ============================================================
# SEGURANCA
# ============================================================
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================
# COMPRESSAO / CACHE
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png image/jpeg image/gif image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>
