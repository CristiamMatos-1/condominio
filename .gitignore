# ============================================================
# SISTEMA DE ASSEMBLEIAS - .gitignore
# ============================================================

# ----- Configuração sensível (NUNCA commitar senhas) -----
/config.php

# ----- Dependências e vendor -----
/vendor/
/composer.lock
/composer.phar
/node_modules/
/package-lock.json
/yarn.lock

# ----- Logs e cache -----
*.log
/logs/
/cache/
/tmp/
/storage/*.key

# ----- Arquivos de ambiente -----
.env
.env.local
.env.*.local

# ----- IDE e editores -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Backup e arquivos temporários -----
*.bak
*.backup
*.old
*.sql
!database/migrations/*.sql

# ----- Uploads e dados do usuário -----
/uploads/
/files/
/public/uploads/

# ----- Debug e profiles -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache

# ----- macOS -----
__MACOSX
.AppleDouble
.LSOverride

# ----- cPanel e hospedagem -----
.htaccess.bak
error_log
/php.ini
