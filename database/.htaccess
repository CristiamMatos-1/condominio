# ============================================================
# .htaccess dentro da pasta /database — BLOQUEIA TUDO
# Não deixe SQL visível publicamente nunca
# ============================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
